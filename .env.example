MONGO_URI=mongodb://127.0.0.1:27017/finance_tracker
JWT_SECRET=change_this_secret_in_production
PORT=5000

# Finance Tracker Backend Configuration

# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/finance-tracker
# Or use MongoDB Atlas:
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/finance-tracker

# JWT Secret (change this to a secure random string)
JWT_SECRET=your-super-secret-jwt-key-change-this

# Server Port
PORT=5000

# Application URL (for welcome emails)
APP_URL=http://localhost:3000

# Email Service - Gmail Configuration (REQUIRED for OTP and welcome emails)
GMAIL_USER=your-email@gmail.com
GMAIL_PASSWORD=your-app-specific-password

# SMS Service - Twilio Configuration (Optional for SMS OTP)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Stripe Payment Gateway
STRIPE_PUBLIC_KEY=pk_test_your_key_here
STRIPE_SECRET_KEY=sk_test_your_key_here

# Razorpay Payment Gateway (for India)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Google Cloud Vision API (for OCR)
GOOGLE_APPLICATION_CREDENTIALS=./path-to-google-credentials.json

# Node Environment
NODE_ENV=development
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password

# Frontend URL
FRONTEND_URL=http://localhost:3000
